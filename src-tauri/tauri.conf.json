{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XProxy Tunnel",
  "version": "0.1.0",
  "identifier": "dev.xproxy.tunnel",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 4175 --strictPort",
    "devUrl": "http://127.0.0.1:4175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [{"label":"main", "title":"XProxy Tunnel", "width":1200,"height":860,"minWidth":900,"minHeight":700}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":true,"targets":"all","icon":["icons/icon.png","icons/icon.icns","icons/icon.ico"]}
}
